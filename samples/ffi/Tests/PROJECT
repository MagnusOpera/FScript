project ffisample_tests {
    includes = [ "**/*" "../../../Directory.Build.props" "../../../tests/FScript.Runtime.Tests/SdkTestHost.fs" "../*.fss" ]
    ignores = [ "**/bin/**" "**/obj/**" "**/TestResults/**" ]
    @dotnet { }
}

target build {
    @dotnet build { }
}

target test {
    depends_on = [ target.^build ]
    outputs = [ "TestResults/" ]
    # Cached builds do not populate NuGet packages on a fresh runner.
    @dotnet restore { }
    @dotnet test { build = false restore = false args = "--logger 'trx;LogFileName=results.trx' --results-directory TestResults" }
}

target test_ffi_managed {
    depends_on = [ target.^build ]
    outputs = [ "TestResults/managed/" ]
    # Cached builds do not populate NuGet packages on a fresh runner.
    @dotnet restore { }
    @dotnet test {
        build = false restore = false
        filter = "TestCategory!=NativeAotDefault&TestCategory!=NativeAotSize"
        args = "--logger 'trx;LogFileName=results.trx' --results-directory TestResults/managed"
    }
}

target test_ffi_default {
    depends_on = [ target.^build ]
    outputs = [ "TestResults/aot-default/" ]
    # Cached builds do not populate NuGet packages on a fresh runner.
    @dotnet restore { }
    @dotnet test {
        build = false restore = false filter = "TestCategory=NativeAotDefault"
        args = "--logger 'trx;LogFileName=results.trx' --results-directory TestResults/aot-default"
    }
}

target test_ffi_size {
    depends_on = [ target.^build ]
    outputs = [ "TestResults/aot-size/" ]
    # Cached builds do not populate NuGet packages on a fresh runner.
    @dotnet restore { }
    @dotnet test {
        build = false restore = false filter = "TestCategory=NativeAotSize"
        args = "--logger 'trx;LogFileName=results.trx' --results-directory TestResults/aot-size"
    }
}
