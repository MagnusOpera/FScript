<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>FScript.Ffi.Sample</AssemblyName><EnableDynamicLoading>true</EnableDynamicLoading></PropertyGroup>
  <ItemGroup>
    <Compile Include="Graphics.fs" />
    <Content Include="*.fss" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Renderer/Renderer.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalFScriptExtensibility)' != 'true'">
    <PackageReference Include="MagnusOpera.FScript.Extensibility" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalFScriptExtensibility)' == 'true'">
    <ProjectReference Include="$(FScriptExtensibilityProject)" />
  </ItemGroup>
</Project>
