let add (a: Vec3) (b: Vec3) : Vec3 =
    { X = a.X + b.X; Y = a.Y + b.Y; Z = a.Z + b.Z }
let scale s (p: Vec3) : Vec3 = { X = s * p.X; Y = s * p.Y; Z = s * p.Z }
let subtract a b = add a (scale ((0.0 - 1.0)) b)
let cross (a: Vec3) (b: Vec3) : Vec3 =
    { X = a.Y * b.Z - a.Z * b.Y
      Y = a.Z * b.X - a.X * b.Z
      Z = a.X * b.Y - a.Y * b.X }

// Cubic Bezier evaluation in Bernstein form.
let curve points t =
    let (a, b, c, d) = points
    let s = 1.0 - t
    let first = add (scale (s * s * s) a) (scale (3.0 * s * s * t) b)
    let second = add (scale (3.0 * s * t * t) c) (scale (t * t * t) d)
    add first second

let tangent points t =
    let (a, b, c, d) = points
    let s = 1.0 - t
    let first = add (scale (3.0 * s * s) (subtract b a)) (scale (6.0 * s * t) (subtract c b))
    add first (scale (3.0 * t * t) (subtract d c))

let vertex patch u v : Vertex =
    let (a, b, c, d) = patch
    let columns = (curve a v, curve b v, curve c v, curve d v)
    let position = curve columns u
    let du = tangent columns u
    let dv = curve (tangent a v, tangent b v, tangent c v, tangent d v) u
    let normal = cross dv du
    let lengthSquared = normal.X * normal.X + normal.Y * normal.Y + normal.Z * normal.Z
    // Collapsed Bezier edges at the lid/bottom need a defined pole normal.
    let safeNormal =
        if lengthSquared < 0.000001 then
            { X = 0.0; Y = if position.Y < 0.0 then (0.0 - 1.0) else 1.0; Z = 0.0 }
        else scale (1.0 / Math.sqrt lengthSquared) normal
    { Position = position; Normal = safeNormal }

let generatePatch segments patchIndex patch =
    let stride = segments + 1
    let offset = patchIndex * stride * stride
    let sample i = Math.toFloat i / Math.toFloat segments
    let vertices =
        [0..segments] |> List.collect (fun u ->
            [0..segments] |> List.map (fun v -> vertex patch (sample u) (sample v)))
    let indices =
        [0..segments - 1] |> List.collect (fun u ->
            [0..segments - 1] |> List.collect (fun v ->
                let a = offset + u * stride + v
                let b = a + stride
                [a; a + 1; b; a + 1; b + 1; b]))
    (vertices, indices)

export let generate requestedSegments : Geometry =
    let segments = if requestedSegments < 2 then 2 else if requestedSegments > 32 then 32 else requestedSegments
    let (_, allVertices, allIndices) =
        patches |> List.fold (fun state patch ->
            let (index, vertices, indices) = state
            let (nextVertices, nextIndices) = generatePatch segments index patch
            (index + 1, nextVertices :: vertices, nextIndices :: indices)) (0, [], [])
    { Name = "Utah teapot"
      Vertices = allVertices |> List.rev |> List.collect (fun values -> values)
      Indices = allIndices |> List.rev |> List.collect (fun values -> values) }
