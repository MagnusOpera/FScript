<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Providers.fs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalFScriptExtensibility)' != 'true'">
    <PackageReference Include="MagnusOpera.FScript.Extensibility" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalFScriptExtensibility)' == 'true'">
    <ProjectReference Include="$(FScriptExtensibilityProject)" />
  </ItemGroup>
</Project>
