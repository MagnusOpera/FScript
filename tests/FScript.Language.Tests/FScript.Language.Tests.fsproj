<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../SupportLibraryCases.fs" Link="SupportLibraryCases.fs" />
    <Compile Include="Helpers.fs" />
    <Compile Include="SupportLibraryTests.fs" />
    <Compile Include="LexerTests.fs" />
    <Compile Include="IncludeResolverTests.fs" />
    <Compile Include="ParserTests.fs" />
    <Compile Include="TypeInferenceTests.fs" />
    <Compile Include="ResolvedInferenceTests.fs" />
    <Compile Include="TaskSharingAnalysisTests.fs" />
    <Compile Include="EvalTests.fs" />
    <Compile Include="InteractiveTests.fs" />
    <Compile Include="PrettyTests.fs" />
    <Compile Include="ExternalTests.fs" />
    <Compile Include="HostExternTests.fs" />
    <Compile Include="HostManagedTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="FsUnit" Version="7.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- FsUnit 7.1.1 depends on TestDelegate, which NUnit 5 removed. -->
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FScript.Language\FScript.Language.fsproj" />
    <ProjectReference Include="..\..\src\FScript.Runtime\FScript.Runtime.fsproj" />
  </ItemGroup>

</Project>
