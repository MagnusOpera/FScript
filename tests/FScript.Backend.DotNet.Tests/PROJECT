project fscript_backend_dotnet_tests {
    includes = [ "**/*" "../../Directory.Build.props" "../../.config/dotnet-tools.json" "../../samples/**/*.fss" "../../samples/**/*.toml" "../../samples/**/*.bas" "../../tests/FScript.Runtime.Tests/SdkTestHost.fs" ]
    ignores = [ "../../samples/**/bin/**" "../../samples/**/obj/**" "../../samples/**/TestResults/**" "../../samples/**/.fscript/**" "**/bin/**" "**/obj/**" "**/TestResults/**" "**/node_modules/**" "**/.fscript/**" ]
    @dotnet { }
}

target build {
    @dotnet build { }
}

target test {
    outputs = [ "TestResults/" ]
    # Cached builds do not populate NuGet packages on a fresh runner.
    @dotnet restore { }
    @dotnet test { build = false restore = false args = "--logger 'trx;LogFileName=results.trx' --results-directory TestResults" }
}
