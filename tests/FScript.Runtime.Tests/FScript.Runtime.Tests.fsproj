<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="HostTestHelpers.fs" />
    <Compile Include="RegistryTests.fs" />
    <Compile Include="FsExternsTests.fs" />
    <Compile Include="RegexExternsTests.fs" />
    <Compile Include="HashExternsTests.fs" />
    <Compile Include="GuidExternsTests.fs" />
    <Compile Include="ConsoleExternsTests.fs" />
    <Compile Include="JsonExternsTests.fs" />
    <Compile Include="XmlExternsTests.fs" />
    <Compile Include="ScriptHostTests.fs" />
    <Compile Include="HostManagedTests.fs" />
    <Compile Include="EnvironmentConfigurationTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="FsUnit" Version="7.1.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- FsUnit 7.1.1 depends on TestDelegate, which NUnit 5 removed. -->
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FScript.Language\FScript.Language.fsproj" />
    <ProjectReference Include="..\..\src\FScript.Runtime\FScript.Runtime.fsproj" />
  </ItemGroup>

</Project>
