project {
    ignores = [ "node_modules/**" "dist/**" "build/**" ".docusaurus/**" "bin/**" "obj/**" ]
}

target check {
    artifacts = ~none
    @shell bash { args = "../.github/scripts/terrabuild-check.sh website" }
}

target install {
    artifacts = ~none
    @shell bash { args = "../.github/scripts/terrabuild-check.sh website-install" }
}

target typecheck {
    artifacts = ~none
    @shell bash { args = "../.github/scripts/terrabuild-check.sh website-typecheck" }
}
