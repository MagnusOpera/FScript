project vscode {
    includes = [ "**/*" "../.build/checks.sh" "../tests/FScript.LanguageServer.Tests/**/*.js" ]
    ignores = [ "node_modules/**" "dist/**" "server/**" "*.vsix" "TestResults/**" "CHANGELOG.md" ]
    @npm { }
}

target install {
    outputs = [ "node_modules/" ]
    @npm install { }
}

target build {
    outputs = [ "dist/" ]
    @npm run { target = "compile" }
}

target test {
    outputs = [ "TestResults/" ]
    workflow run { script = "../.build/checks.sh" args = "vscode" }
}
