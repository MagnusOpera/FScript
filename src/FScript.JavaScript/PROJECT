project javascript {
    includes = [ "**/*" "../../Directory.Build.props" "../../.config/dotnet-tools.json" ]
    ignores = [ "dist/**" "**/bin/**" "**/obj/**" "**/TestResults/**" "**/node_modules/**" "**/.fscript/**" ]
    @dotnet { }
}

target build {
    outputs = [ "bin/" "obj/" "dist/" ]
    @dotnet build { dependencies = false }
    @dotnet tool { args = "restore" }
    @npm build { }
}

target test {
    outputs = []
    @npm test { }
}
