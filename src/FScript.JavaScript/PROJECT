project {
    ignores = [ "node_modules/**" "dist/**" "build/**" ".docusaurus/**" "bin/**" "obj/**" ]
}

target check {
    artifacts = ~none
    @shell bash { args = "../../.github/scripts/terrabuild-check.sh fable" }
}

target javascript_build {
    artifacts = ~none
    @shell bash { args = "../../.github/scripts/terrabuild-check.sh fable-build" }
}
