<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup><Compile Include="DotNetTypes.fs" /><Compile Include="DotNetCollectionRepresentations.fs" /><Compile Include="DotNetCollectionFusion.fs" /><Compile Include="DotNetOptimization.fs" /><Compile Include="DotNetDeadCaptures.fs" /><Compile Include="DotNetSourceOptimization.fs" /><Compile Include="DotNetPackaging.fs" /><Compile Include="DotNetIlInlining.fs" /><Compile Include="DotNetBackend.fs" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../FScript.Backend.CSharp/FScript.Backend.CSharp.fsproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="Mono.Cecil" Version="0.11.6" /></ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
