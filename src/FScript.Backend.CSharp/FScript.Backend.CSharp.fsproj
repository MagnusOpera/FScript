<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="CSharpBackend.fs" />
    <EmbeddedResource Include="RuntimePure.cs" LogicalName="FScript.Backend.CSharp.RuntimePure.cs" />
    <EmbeddedResource Include="Runtime.cs" LogicalName="FScript.Backend.CSharp.Runtime.cs" />
    <EmbeddedResource Include="RuntimeListViews.cs" LogicalName="FScript.Backend.CSharp.RuntimeListViews.cs" />
    <EmbeddedResource Include="RuntimeSDK.cs" LogicalName="FScript.Backend.CSharp.RuntimeSDK.cs" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../FScript.Compiler/FScript.Compiler.fsproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" /></ItemGroup>
</Project>
