          "reports": ["tests/FScript.Language.Tests/TestResults/results.trx", "tests/FScript.Runtime.Tests/TestResults/results.trx", "tests/FScript.Compiler.Tests/TestResults/results.trx", "tests/FScript.Conformance.Tests/TestResults/results.trx", "tests/FScript.Interpreter.Lir.Tests/TestResults/results.trx", "tests/FScript.LanguageServer.Tests/TestResults/results.trx"]
        },
        {
          "targets": ["test_ffi_managed"],
          "projects": ["ffisample_tests"],
          "reports": ["samples/ffi/Tests/TestResults/managed/results.trx"]
        }
      ]
    },
    {
      "name": "backend",
      "runs": [
        {
          "targets": ["test"],
          "projects": ["fscript_backend_dotnet_tests"],
          "reports": ["tests/FScript.Backend.DotNet.Tests/TestResults/results.trx"]
        }
      ]
    },
    {
      "name": "cli",
      "runs": [
        {
          "targets": ["test"],
          "projects": ["fscript_cli_tests"],
          "reports": ["tests/FScript.Cli.Tests/TestResults/results.trx"]
        }
      ]
    },
    {
      "name": "ffi-default",
      "runs": [
        {
          "targets": ["test_ffi_default"],
          "projects": ["ffisample_tests"],
          "reports": ["samples/ffi/Tests/TestResults/aot-default/results.trx"]
        }
      ]
    },
    {
      "name": "ffi-size",
      "runs": [
        {
          "targets": ["test_ffi_size"],
          "projects": ["ffisample_tests"],
          "reports": ["samples/ffi/Tests/TestResults/aot-size/results.trx"]
        }
      ]
    },
    {
      "name": "web",
      "runs": [
        {
          "targets": ["test"],
          "projects": ["javascript", "vscode"],
