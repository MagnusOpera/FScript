project toolchain {
    labels = [ "toolchain" ]
    includes = [ "**/*" "Dockerfile" "../../WORKSPACE" ]
}

# Always check/build the local image. Docker reuses its layers. Phase barriers do
# not force cached application targets to execute, and no image is pushed.
target image {
    phase = phase.toolchains
    build = ~always
    artifacts = ~none
    @shell docker {
        args = "build --build-arg DOTNET_SDK_VERSION=${local.versions.dotnet_sdk} --build-arg NODE_VERSION=${local.versions.node} --tag fscript-build:${terrabuild.version} ."
    }
}
