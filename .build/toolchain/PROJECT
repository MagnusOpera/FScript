project toolchain {
    labels = [ "toolchain" ]
    includes = [ "**/*" "../../WORKSPACE" "../build-toolchain.sh" "../workflow.fss" ]
    @docker { }
}

target dist {
    phase = phase.toolchains
    toolchain build {
        dotnet_sdk = local.versions.dotnet_sdk
        node = local.versions.node
        platform = "linux/${terrabuild.arch}"
    }
}
