project toolchain {
    labels = [ "toolchain" ]
    includes = [ "Dockerfile" "PROJECT" "image.sh" ]
}

# CI builds publish missing images; shards only pull. Local runs build locally.
target image {
    phase = phase.toolchains
    build = ~always
    artifacts = ~none
    @shell bash {
        args = "image.sh ghcr.io/magnusopera/fscript-toolchain:${terrabuild.version}-sdk${local.versions.dotnet_sdk}-node${local.versions.node}-${terrabuild.arch} ${local.versions.dotnet_sdk} ${local.versions.node} linux/${terrabuild.arch}"
    }
}
